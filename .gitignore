# Build output
bin/
obj/
out/
publish/
artifacts/
*.binlog

# Logs
logs/
*.log

# Local secrets / overrides
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
CupriCut.Local.json
CupriCut.*.Local.json
secrets.json
.env
.env.*

# Rendered output. A renderer writes files for a living, and none of them belong in git —
# Cut:OutputRoot points somewhere under here by default.
output/
frames/
*.mp4
*.webm
*.mov
*.apng

# …but a composition's own assets do belong, so a PNG under compositions/ is committed on purpose.
!compositions/**/*.png

# Projects are the read-write root: an agent's working files, not the repository's.
projects/*
# ...except the worked example, so a fresh clone has something to render.
!projects/demo.cut.json

# Fonts are licensed separately and are a deliberate decision every time, never an accident.
*.ttf
*.otf
*.ttc
*.woff
*.woff2

# The deliberate decision the rule above asks for: the two Noto Sans faces CupriCut ships so that
# FontPolicy.RegisteredOnly - which is always on - has something to resolve to on a bare install.
# SIL Open Font Licence 1.1, text in fonts/OFL.txt.
!fonts/NotoSans-Regular.ttf
!fonts/NotoSans-Bold.ttf

# Editors
.vs/
.idea/
*.user
# Per-developer window colours (Peacock and friends). launch.json and tasks.json ARE committed:
# they say how to run this thing, which is repository knowledge.
.vscode/settings.json
