<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine. Time is an argument: doc.Animate(t) is what the whole renderer stands on. -->
    <PackageVersion Include="CupriFace" Version="0.41.0" />
    <PackageVersion Include="CupriFace.Shell" Version="0.41.0" />
    <!--
      Optional, and NOT optional for this tool. A .woff2 the engine cannot decode is
      refused by name, and FontPolicy.RegisteredOnly then fails the render - which is
      correct and useless, because .woff2 is what every font pipeline emits. Shipped in
      0.28.1; the host installs the decoder with UseWoff2().
    -->
    <PackageVersion Include="CupriFace.Woff2" Version="0.41.0" />
    <!--
      Inline <svg>, which the engine keeps as markup and draws only once this package has
      claimed it. Optional for an application and near-mandatory for this one: an icon or a
      logo arrives as SVG, and without the package it laid out at its CSS size and painted
      nothing - present, sized and empty, which every automatic check calls fine. The host
      installs it with UseSvg().
    -->
    <PackageVersion Include="CupriFace.Svg" Version="0.41.0" />
    <!--
      The translator, as a dependency rather than at arm's length - the one question Milestone 5
      left open for this repository. Browser HTML in, CupriFace-safe HTML plus a report out.

      It does NOT depend on CupriFace, and it does not depend on CupriCut: it re-implements the
      .cutpkg schema from a copied DTO rather than referencing CutProject, so that the compiler
      does not need a renderer to build. The direction of travel is unchanged by taking the
      reference - a composition is translated ONCE, into a project, and nothing consults the
      translator at render time.

      Prerelease, and it will stay prerelease while AngleSharp.Css is: NuGet will not let a stable
      package depend on a prerelease one.
    -->
    <PackageVersion Include="CupriLex.Compiler" Version="0.1.0-alpha.2" />
    <!-- Pinned to the engine's own SkiaSharp: SKImage and SKCanvas cross the boundary. -->
    <PackageVersion Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>
</Project>
