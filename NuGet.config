<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    A clear element first, so these two are the ONLY sources. Without it a restore resolves against
    whatever feeds happen to be configured on the machine doing it, which is how a public
    repository quietly acquires a dependency nobody else can restore.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>

  <!--
    Source mapping, because central package management warns without it (NU1507) and because the
    warning is right: with two feeds and no map, which one answers for a given package id is a
    race. Only the Cupri packages come from GitHub; everything else is nuget.org.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <package pattern="CupriFace*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    NO CREDENTIALS HERE, deliberately, and you will still need some.

    GitHub Packages requires authentication to RESTORE a NuGet package, including a public one,
    unlike its npm and Maven registries which serve public packages anonymously. CupriFace is MIT
    and its repository is public, and an anonymous build still cannot fetch it.

    In CI the workflow supplies the built-in GITHUB_TOKEN for this source. Locally, run
    "dotnet nuget update source GitHub-Wixely-Packages" once, passing your GitHub username and a
    personal access token with the read:packages scope, plus the store-password-in-clear-text
    option. See README.md for the exact command.

    That writes to your USER level NuGet config and never to this file, which is why this file has
    no credentials section for a token to be committed into by accident.
  -->

</configuration>
