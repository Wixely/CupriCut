<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- Two executables where one references the other must AGREE about self-containment, or the
         SDK refuses with NETSDK1151 - and the moment a RuntimeIdentifier is present the referenced
         exe resolves to self-contained no matter what the publish was told. Neither the
         self-contained switch nor a global SelfContained property reaches across the
         ProjectReference; both were measured. A custom property does flow, so the release matrix
         sets this one thing and both halves land on the same answer. Unset, nothing changes. -->
    <SelfContained Condition="'$(CupriCutSelfContained)' != ''">$(CupriCutSelfContained)</SelfContained>
    <RootNamespace>CupriCut</RootNamespace>
    <AssemblyName>CupriCut</AssemblyName>
    <ApplicationIcon>cupricut.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The project sits at the repository root, so the default glob would swallow the CLI's own
         Main and the test project. Flat layout, explicit exclusions - see PLAN.md. -->
    <Compile Remove="cli\**;tests\**;output\**" />
    <None Remove="cli\**;tests\**;output\**" />
    <EmbeddedResource Remove="cli\**;tests\**;output\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests exercise the tool layer's helpers directly - frame-count arithmetic above all,
         which is where an off-by-one becomes a video of the wrong length. Better than making
         ToolSupport public purely so a test can reach it. -->
    <InternalsVisibleTo Include="CupriCut.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CupriFace" />
    <!-- The desktop window. The MCP server does not need it, but one binary serves both faces and
         -c is what turns the window off (Docker and Windows Service imply it). -->
    <PackageReference Include="CupriFace.Shell" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="cupricut.ico" LogicalName="CupriCut.cupricut.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="CupriCut.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="CupriCut.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>CupriCut.json</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts registered into every document. FontPolicy.RegisteredOnly is always on, so a server
         with no registered face fails every composition that does not carry its own @font-face. -->
    <None Include="fonts\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- The worked examples, so a fresh install has something to render. -->
    <None Include="compositions\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- ...and the same examples again as PROJECTS, so the studio window has something in its
         picker on a first run. Without this it opens to an empty list and "save one with
         save_project", which is no use to someone who just wants to look at it.

         An explicit Link rather than LinkBase: LinkBase is silently ignored here, and the files
         land at their SOURCE path - examples/ in the output rather than projects/ - which looks
         like the copy simply did not happen. The two entries above never needed it only because
         their source path already is their output path.

         PreserveNewest, so a project edited in the output directory survives a rebuild. -->
    <None Include="examples\**" CopyToOutputDirectory="PreserveNewest">
      <Link>projects\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
